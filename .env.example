# EduAgentX — 本地开发环境变量示例
# 复制为 .env 并填入真实值

# ── LLM / AI Agent ──
LLM_API_KEY=your_llm_api_key
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ── TTS ──
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# ── 应用配置 ──
APP_ENV=development
APP_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars!!
DATABASE_URL=postgresql+asyncpg://eduagentx:eduagentx@localhost:5432/eduagentx
REDIS_URL=redis://localhost:6379/0

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eduagentx
MINIO_SECURE=false

# ── 前端 ──
PUBLIC_FRONTEND_URL=http://127.0.0.1:8081
