# ===========================================
# EduAgentX Backend Environment Variables
# ===========================================

# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-64-random-characters

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://eduagentx:eduagentx@localhost:5432/eduagentx

# Redis
REDIS_URL=redis://localhost:6379/0

# Cookie configuration
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CSRF
CSRF_COOKIE_NAME=csrftoken
CSRF_HEADER_NAME=X-CSRF-Token

# Token TTL (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=INFO

# LLM / AI Agent Configuration
# Set these to enable real LLM-powered content generation.
# If not set, the system falls back to template-based generation.
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=180

# Object storage. Development uses LOCAL_STORAGE_PATH when MinIO is unset.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eduagentx
MINIO_SECURE=false
LOCAL_STORAGE_PATH=.local-storage

