/* =========================================================
   EduAgentX Minimal Desktop Theme
   风格：极简 / 高级感 / 蓝灰科技风 / 弱边框 / 大留白
   ========================================================= */

/* 全局 */
QMainWindow {
    background-color: #F8FAFC;
    font-family: "Microsoft YaHei UI", "PingFang SC", Arial;
    font-size: 14px;
    color: #0F172A;
}

QWidget {
    font-family: "Microsoft YaHei UI", "PingFang SC", Arial;
    color: #0F172A;
}

/* 主容器 */
QWidget#RootWidget {
    background-color: #F8FAFC;
}

/* 顶部导航栏 */
QFrame#HeaderBar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}

QLabel#AppTitle {
    font-size: 22px;
    font-weight: 800;
    color: #0F172A;
}

QLabel#AppSubtitle {
    font-size: 12px;
    color: #64748B;
}

QLabel#BackendStatusConnected {
    color: #16A34A;
    font-size: 13px;
    font-weight: 600;
}

QLabel#BackendStatusDisconnected {
    color: #DC2626;
    font-size: 13px;
    font-weight: 600;
}

/* 分区标题 */
QLabel#SectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    padding: 0;
}

QLabel#SectionSubTitle {
    font-size: 12px;
    color: #64748B;
}

/* 卡片 */
QFrame#Card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}

QFrame#SoftCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
}

/* 输入框 */
QTextEdit#PromptInput {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 14px;
    padding: 12px;
    font-size: 14px;
    color: #0F172A;
    selection-background-color: #BFDBFE;
}

QTextEdit#PromptInput:focus {
    border: 1px solid #2563EB;
}

/* 只读文本区域 */
QTextBrowser {
    background-color: #FFFFFF;
    border: none;
    padding: 8px;
    font-size: 14px;
    color: #1E293B;
}

QTextBrowser#CardTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* 资源展示区 */
QTextBrowser#ResourceBrowser {
    background-color: #FFFFFF;
    border: none;
    padding: 18px;
    font-size: 14px;
    color: #1E293B;
}

/* 列表 */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 13px;
}

QListWidget::item {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 9px;
    margin: 4px 0;
}

QListWidget::item:hover {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
}

QListWidget::item:selected {
    background-color: #DBEAFE;
    color: #1E3A8A;
    border: 1px solid #93C5FD;
}

/* 下拉框 */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 7px 12px;
    min-height: 22px;
    min-width: 120px;
    color: #334155;
}

QComboBox:hover {
    border: 1px solid #94A3B8;
}

QComboBox:focus {
    border: 1px solid #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}

/* 默认按钮：次级按钮 */
QPushButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border: 1px solid #94A3B8;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    color: #94A3B8;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
}

/* 主按钮 */
QPushButton#PrimaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}

QPushButton#PrimaryButton:hover {
    background-color: #1D4ED8;
    border: 1px solid #1D4ED8;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1E40AF;
}

/* 紫色按钮：演示样例 */
QPushButton#PurpleButton {
    background-color: #F5F3FF;
    color: #6D28D9;
    border: 1px solid #DDD6FE;
}

QPushButton#PurpleButton:hover {
    background-color: #EDE9FE;
    border: 1px solid #C4B5FD;
}

/* 绿色按钮：导出 */
QPushButton#GreenButton {
    background-color: #F0FDF4;
    color: #15803D;
    border: 1px solid #BBF7D0;
}

QPushButton#GreenButton:hover {
    background-color: #DCFCE7;
    border: 1px solid #86EFAC;
}

/* 灰色按钮：停止 */
QPushButton#GrayButton {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #CBD5E1;
}

QPushButton#GrayButton:hover {
    background-color: #E2E8F0;
}

/* 青色按钮：后端检测 */
QPushButton#CyanButton {
    background-color: #ECFEFF;
    color: #0E7490;
    border: 1px solid #A5F3FC;
}

QPushButton#CyanButton:hover {
    background-color: #CFFAFE;
}

/* 进度条 */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 8px;
    text-align: center;
    height: 18px;
    color: #0F172A;
    font-size: 12px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 8px;
}

/* Tabs */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    top: -1px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    padding: 8px 14px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-size: 13px;
}

QTabBar::tab:hover {
    background-color: #E0F2FE;
    color: #0369A1;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    font-weight: 700;
    border-top: 2px solid #2563EB;
}

/* 分割器 */
QSplitter::handle {
    background-color: #E2E8F0;
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* 滚动条 */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
