# ===========================================
# EduAgentX Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and adjust values.
# Vite only exposes variables prefixed with VITE_.

# -------------------------------------------
# MSW (Mock Service Worker)
# -------------------------------------------
# Enable MSW for local development with mock API.
# Set to "true" to intercept API calls with MSW handlers.
VITE_ENABLE_MSW=true

# -------------------------------------------
# API Proxy
# -------------------------------------------
# Target URL for the Vite dev server proxy (/api → target).
# Used when VITE_ENABLE_MSW=false to forward to a real backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# -------------------------------------------
# Test API Exposure
# -------------------------------------------
# Expose internal test helpers (e.g. __mock__/reset) in the UI.
# Only for E2E testing — must be "false" in production.
VITE_EXPOSE_TEST_API=false

# -------------------------------------------
# CSRF Protection
# -------------------------------------------
# Cookie name where the backend sets the CSRF token.
VITE_CSRF_COOKIE_NAME=csrftoken

# Header name the frontend sends on unsafe HTTP methods.
VITE_CSRF_HEADER_NAME=X-CSRF-Token
