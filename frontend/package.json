{
  "name": "eduagentx-desktop",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/cleanup-production-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "e2e:serve:mock": "cross-env VITE_ENABLE_MSW=true vite --host 127.0.0.1 --port 5173 --strictPort",
    "e2e:serve:auth-mock": "cross-env VITE_ENABLE_MSW=false VITE_EXPOSE_TEST_API=true VITE_API_PROXY_TARGET=http://127.0.0.1:8001 vite --host 127.0.0.1 --port 5174 --strictPort",
    "e2e:serve:real": "cross-env VITE_ENABLE_MSW=false VITE_EXPOSE_TEST_API=true VITE_API_PROXY_TARGET=http://127.0.0.1:8002 vite --host 127.0.0.1 --port 5175 --strictPort",
    "e2e:auth-server": "node e2e/auth-mock-server.js",
    "e2e": "playwright test --config=playwright.mock.config.ts",
    "e2e:mock": "playwright test --config=playwright.mock.config.ts --project=mock-learning-flow",
    "e2e:auth-mock": "playwright test --config=playwright.mock.config.ts --project=auth-protocol-mock",
    "e2e:real": "playwright test --config=playwright.real.config.ts",
    "e2e:real:auth": "playwright test --config=playwright.real.config.ts --project=real-backend-auth",
    "e2e:real:sse": "playwright test --config=playwright.real.config.ts --project=real-backend-task-sse",
    "e2e:all": "npm run e2e:mock && npm run e2e:auth-mock",
    "e2e:ui": "playwright test --config=playwright.mock.config.ts --ui",
    "e2e:install": "playwright install chromium",
    "build:analyze": "vite build --mode analyze",
    "verify:production": "node scripts/verify-production.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:contract": "vite-node scripts/check-api-contract.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:check": "tauri info",
    "release:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.0.4",
    "clsx": "^2.1.0",
    "elkjs": "^0.9.3",
    "framer-motion": "^11.0.24",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.2",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "msw": "^2.14.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
